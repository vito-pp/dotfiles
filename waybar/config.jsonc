{
  "position": "bottom",
  "height": 28,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
    "sway/window"
  ],
  "modules-center": [],
  "modules-right": [
    "privacy",
    "idle_inhibitor",
    "backlight",
    "pulseaudio",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "battery",
    "sway/language",
    "clock",
    "custom/power"
  ],
  "sway/workspaces": {
    "format": "{value}"
  },
  "sway/mode": {
    "format": "mode {}"
  },
  "sway/scratchpad": {
    "format": "sp {count}",
    "show-empty": false,
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/window": {
    "format": "{}",
    "max-length": 100,
    "tooltip": false
  },
  "sway/language": {
    "format": "{short}",
    "tooltip": false,
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": false
    // "tooltip-format-activated": "Idle inhibition enabled",
    // "tooltip-format-deactivated": "Idle inhibition disabled"
  },
  "backlight": {
    "format": "bri {percent}%",
    "tooltip": false
  },
"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "mute",
    "format-bluetooth": "blt {volume}%",
    "format-bluetooth-muted": "mute bt",

    "format-icons": {
        "headphone": "ear",
        "headset": "ear",
        "hands-free": "ear",
        "default": "vol"
    },

    "on-click": "pavucontrol",
    "tooltip": false
},
  "bluetooth": {
      "format": "<span size='15000'></span>",
      "format-disabled": "<span size='15000'>󰂲</span>",
      "format-off": "<span size='15000'>󰂲</span>",
      "format-connected": "<span size='15000'>󰂱</span>",
      "tooltip": false,
      "on-click": "blueman-manager"
  },
  "network": {
    "format-wifi": "WiFi {signalStrength}%",
    "format-ethernet": "lan",
    "format-linked": "link",
    "format-disconnected": "net down",
    "format-disabled": "net off",
    "tooltip": true,
    "tooltip-format": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "interval": 3,
    "on-click": "~/.config/waybar/scripts/nmtui-popup.sh"
  },
  "cpu": {
    "format": "cpu {usage}%",
    "interval": 3,
    "states": {
      "warning": 85,
      "critical": 95
    }
  },
  "memory": {
    "format": "ram {percentage}%",
    "interval": 3,
    "states": {
      "warning": 85,
      "critical": 95
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "interval": 3,
    "format": "bat {capacity}%",
    "format-full": "bat full",
    "format-charging": "bat {capacity}%+",
    "format-plugged": "bat {capacity}%+",
    "format-alt": "{time}"
  },
  "clock": {
    "timezone": "America/Argentina/Buenos_Aires",
    "format": "{:%a %d %b %H:%M}",
    "tooltip": true,
    "tooltip-format": "<span font='DejaVu Sans Mono' size='12pt'>{calendar}</span>",
    "on-click": "gnome-calendar",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ff5555'><b>{}</b></span>",
        "days": "<span color='#dddddd'>{}</span>",
        "weekdays": "<span color='#4c7899'><b>{}</b></span>",
        "today": "<span color='#00cc66'><b>{}</b></span>"
      }
    }
  },
  "custom/power": {
    "format": "pwr",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu/powermenu.sh"
  },
  "privacy": {
    "icon-size": 18,
    "icon-spacing": 4,
    "modules": [
      {
        "type": "audio-in",
        "tooltip": true
      },
      {
        "type": "audio-out",
        "tooltip": true
      },
      {
        "type": "screenshare",
        "tooltip": true
      }
    ]
  }
}
